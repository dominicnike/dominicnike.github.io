---
import { SITE } from '../consts';
import { getPosts, getTagCounts } from '../utils';

const tags = getTagCounts(await getPosts());
---

<aside class="sidebar">
  <div class="sidebar-card">
    <h4 class="sidebar-heading">About the Author</h4>
    <div class="author-bio">
      <img src={SITE.avatar} alt={SITE.author} class="author-avatar" width="48" height="48" />
      <div>
        <p class="author-name">{SITE.author}</p>
        <p class="author-text">{SITE.role} sharing hands-on cloud and DevOps guides.</p>
        <a href="/about" class="sidebar-link">More about me →</a>
      </div>
    </div>
  </div>
  <div class="sidebar-card">
    <h4 class="sidebar-heading">Popular Tags</h4>
    <div class="tag-cloud">
      {
        tags.slice(0, 12).map((t) => (
          <a class="tag-item" href={`/tags/${t.slug}`}>
            <span>{t.name}</span>
            <span class="tag-count">{t.count}</span>
          </a>
        ))
      }
    </div>
  </div>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 90px; }
  .sidebar-card { background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; }
  .sidebar-heading { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin: 0 0 1.1rem; }
  .author-bio { display: flex; gap: 1rem; align-items: flex-start; }
  .author-avatar { border-radius: 50%; border: 2px solid var(--color-border); flex-shrink: 0; }
  .author-name { font-weight: 700; margin: 0 0 0.3rem; }
  .author-text { color: var(--color-text-muted); font-size: 0.82rem; margin: 0 0 0.5rem; line-height: 1.5; }
  .sidebar-link { font-size: 0.82rem; font-weight: 600; }
  .tag-cloud { display: flex; flex-direction: column; gap: 0.3rem; }
  .tag-item { display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.6rem; border-radius: var(--radius-md); color: var(--color-text-muted); font-size: 0.86rem; }
  .tag-item:hover { background: var(--color-bg-card); color: var(--color-primary); text-decoration: none; }
  .tag-count { background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 100px; padding: 0 0.5rem; font-size: 0.75rem; min-width: 24px; text-align: center; }
  @media (max-width: 1024px) {
    .sidebar { position: static; display: grid; grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .sidebar { grid-template-columns: 1fr; }
  }
</style>
