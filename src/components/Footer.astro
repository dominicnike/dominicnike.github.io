---
import { NAV, SITE, SOCIALS } from '../consts';
import { getPosts, getTagCounts } from '../utils';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
const topics = getTagCounts(await getPosts()).slice(0, 5);
const github = SOCIALS.find((s) => s.icon === 'github')!.url;
const initials = SITE.author.split(' ').map((n) => n[0]).join('');
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" class="brand">
        <span class="brand-mark">{initials}</span>
        <span class="brand-text">
          <span class="brand-name">CLOUD WITH <span class="grad">DOMINIC</span></span>
          <span class="brand-sub">AZURE · DEVOPS · AI</span>
        </span>
      </a>
      <p class="brand-desc">
        {SITE.role} building secure, scalable cloud platforms and automation with Azure, Kubernetes, Infrastructure
        as Code and AI.
      </p>
      <SocialLinks variant="ghost" />
    </div>

    <nav class="footer-col" aria-label="Explore">
      <h4>Explore</h4>
      <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>

    <nav class="footer-col" aria-label="Topics">
      <h4>Topics</h4>
      <ul>{topics.map((t) => <li><a href={`/tags/${t.slug}`}>{t.name}</a></li>)}</ul>
    </nav>

    <nav class="footer-col" aria-label="Feeds">
      <h4>Feeds</h4>
      <ul>
        <li><a href="/rss.xml">RSS Feed</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
        <li><a href={github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-inner">
      <span>© {year} {SITE.author}</span>
      <span class="built"><span class="dot"></span>{SITE.brand} Insights · built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></span>
    </div>
  </div>
</footer>

<button class="to-top" id="toTop" aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"></path></svg>
</button>

<script>
  const btn = document.getElementById('toTop');
  const toggle = () => btn?.classList.toggle('show', window.scrollY > 400);
  window.addEventListener('scroll', toggle, { passive: true });
  toggle();
  btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>

<style>
  .site-footer { margin-top: 5rem; border-top: 1px solid var(--color-border); background: var(--color-bg); }
  .footer-main {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2.5rem; padding-top: 3rem; padding-bottom: 3rem;
  }
  .brand { display: inline-flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; font-weight: 800; font-size: 0.9rem;
    color: #fff; background: radial-gradient(circle at 30% 30%, var(--color-accent), var(--color-primary) 70%);
    box-shadow: 0 0 18px color-mix(in srgb, var(--color-accent) 45%, transparent);
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.2; }
  .brand-name { font-weight: 800; font-size: 1rem; letter-spacing: 0.04em; color: var(--color-text); }
  .grad { background: linear-gradient(90deg, var(--color-primary), var(--color-accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .brand-sub { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.2em; color: var(--color-text-muted); margin-top: 0.2rem; }
  .brand-desc { color: var(--color-text-muted); font-size: 0.92rem; max-width: 38ch; margin: 0 0 1.25rem; }
  .footer-col h4 {
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-accent); margin: 0.4rem 0 1.25rem;
  }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .footer-col a { color: var(--color-text-muted); font-size: 0.92rem; }
  .footer-col a:hover { color: var(--color-accent); text-decoration: none; }
  .footer-bottom { border-top: 1px solid var(--color-border); padding: 1.25rem 0; }
  .bottom-inner {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
    font-family: var(--font-mono); font-size: 0.78rem; color: var(--color-text-muted);
  }
  .built { display: inline-flex; align-items: center; gap: 0.4rem; }
  .built a { color: var(--color-accent); font-weight: 600; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 8px #10b981; }
  .to-top {
    position: fixed; right: 1.5rem; bottom: 1.5rem; z-index: 40; width: 44px; height: 44px; border-radius: 50%;
    border: none; cursor: pointer; display: grid; place-items: center; color: #04131a;
    background: var(--color-accent); box-shadow: 0 8px 24px color-mix(in srgb, var(--color-accent) 40%, transparent);
    opacity: 0; transform: translateY(12px); pointer-events: none; transition: all var(--transition);
  }
  .to-top.show { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover { filter: brightness(1.1); }
  @media (max-width: 860px) {
    .footer-main { grid-template-columns: 1fr 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-main { grid-template-columns: 1fr 1fr; }
  }
</style>
