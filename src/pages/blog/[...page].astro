---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE } from '../../consts';
import { getPosts } from '../../utils';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pageHref = (n: number) => (n === 1 ? '/blog' : `/blog/${n}`);
---

<BaseLayout title="Blog" description={SITE.description}>
  <div class="container blog-page">
    <header class="page-header">
      <h1 class="page-title">Blog</h1>
      <p class="page-description">{SITE.description}</p>
      <span class="post-count">{page.total} articles</span>
    </header>
    <div class="blog-layout">
      <div>
        <div class="posts-grid two">
          {page.data.map((post) => <BlogCard post={post} />)}
        </div>
        {
          page.lastPage > 1 && (
            <nav class="pagination" aria-label="Pagination">
              <span class="pagination-info">
                Page {page.currentPage} of {page.lastPage}
              </span>
              <div class="pagination-links">
                <a class:list={['pg', { disabled: !page.url.prev }]} href={page.url.prev ?? '#'}>← Prev</a>
                {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
                  <a class:list={['pg', { active: n === page.currentPage }]} href={pageHref(n)}>{n}</a>
                ))}
                <a class:list={['pg', { disabled: !page.url.next }]} href={page.url.next ?? '#'}>Next →</a>
              </div>
            </nav>
          )
        }
      </div>
      <Sidebar />
    </div>
  </div>
</BaseLayout>

<style>
  .blog-page { padding: 3rem 1.5rem 1rem; }
  .page-header { margin-bottom: 2.5rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 0.75rem; }
  .page-description { color: var(--color-text-muted); font-size: 1.1rem; max-width: 60ch; }
  .post-count { display: inline-block; padding: 0.3rem 0.85rem; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: 100px; font-size: 0.8rem; color: var(--color-text-muted); }
  .blog-layout { display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start; }
  .posts-grid.two { grid-template-columns: repeat(2, 1fr); }
  .pagination { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .pagination-info { font-size: 0.85rem; color: var(--color-text-muted); }
  .pagination-links { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .pg { padding: 0.35rem 0.75rem; border-radius: var(--radius-md); font-size: 0.85rem; border: 1px solid var(--color-border); background: var(--color-bg-card); color: var(--color-text); }
  .pg:hover { border-color: var(--color-primary); color: var(--color-primary); text-decoration: none; }
  .pg.active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .pg.disabled { opacity: 0.4; pointer-events: none; }
  @media (max-width: 1024px) { .blog-layout { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .posts-grid.two { grid-template-columns: 1fr; } }
</style>
