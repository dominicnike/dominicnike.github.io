---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { SITE } from '../../consts';
import { formatDate, getPosts, readingTime, slugifyTag, type Post } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  all: Post[];
}

const { post, newer, older, all } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
const toc = headings.filter((h) => h.depth <= 3);
const related = all
  .filter((p) => p.id !== post.id && p.data.tags.some((t) => tags.includes(t)))
  .slice(0, 3);
const shareUrl = encodeURIComponent(new URL(`/blog/${post.id}`, Astro.site).toString());
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
  <div class="progress" id="progress"></div>
  <article class="container post">
    <header class="post-header">
      <div class="post-tags">
        {tags.map((t) => <a class="tag" href={`/tags/${slugifyTag(t)}`}>{t}</a>)}
      </div>
      <h1>{title}</h1>
      <p class="post-desc">{description}</p>
      <div class="post-meta">
        <img src={SITE.avatar} alt="" width="40" height="40" />
        <div>
          <strong>{SITE.author}</strong>
          <span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {updatedDate && <> · Updated {formatDate(updatedDate)}</>} · {readingTime(post.body)}
          </span>
        </div>
      </div>
      {heroImage && <img class="post-hero" src={heroImage} alt="" />}
    </header>

    <div class="post-layout">
      <div class="prose">
        <Content />
      </div>
      {
        toc.length > 0 && (
          <aside class="toc">
            <h4>On this page</h4>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <div class="share">
      <span>Share:</span>
      <a target="_blank" rel="noopener" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}>LinkedIn</a>
      <a target="_blank" rel="noopener" href={`https://x.com/intent/tweet?url=${shareUrl}&text=${encodeURIComponent(title)}`}>X</a>
    </div>

    <nav class="post-nav">
      {older ? <a href={`/blog/${older.id}`}><span>← Older</span>{older.data.title}</a> : <span />}
      {newer && <a class="right" href={`/blog/${newer.id}`}><span>Newer →</span>{newer.data.title}</a>}
    </nav>

    {
      related.length > 0 && (
        <section class="related">
          <h2>Related Articles</h2>
          <div class="posts-grid">
            {related.map((p) => <BlogCard post={p} />)}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById('progress');
  const update = () => {
    const h = document.documentElement;
    const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
    if (bar) bar.style.width = `${Math.min(100, pct)}%`;
  };
  document.addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; height: 3px; width: 0; z-index: 60; background: linear-gradient(90deg, var(--color-primary), var(--color-accent)); }
  .post { padding-top: 3rem; }
  .post-header { max-width: 820px; margin-bottom: 2.5rem; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .post-header h1 { font-size: clamp(2rem, 5vw, 2.9rem); margin: 1rem 0; }
  .post-desc { font-size: 1.15rem; color: var(--color-text-muted); }
  .post-meta { display: flex; align-items: center; gap: 0.8rem; margin-top: 1.5rem; }
  .post-meta img { border-radius: 50%; border: 2px solid var(--color-border); }
  .post-meta div { display: flex; flex-direction: column; font-size: 0.88rem; }
  .post-meta span { color: var(--color-text-muted); }
  .post-hero { width: 100%; margin-top: 2rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); }
  .post-layout { display: grid; grid-template-columns: minmax(0, 820px) 260px; gap: 3rem; align-items: start; }
  .toc { position: sticky; top: 90px; font-size: 0.85rem; border-left: 1px solid var(--color-border); padding-left: 1.25rem; }
  .toc h4 { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; color: var(--color-text-muted); margin: 0 0 0.75rem; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; }
  .toc a { color: var(--color-text-muted); }
  .toc a:hover { color: var(--color-primary); text-decoration: none; }
  .toc .d3 { padding-left: 0.9rem; }
  .share { display: flex; gap: 1rem; align-items: center; margin: 3rem 0 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 0.9rem; }
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .post-nav a { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-card); color: var(--color-text); font-weight: 600; }
  .post-nav a:hover { border-color: var(--color-primary); text-decoration: none; }
  .post-nav a span { font-size: 0.8rem; color: var(--color-text-muted); font-weight: 500; }
  .post-nav .right { text-align: right; grid-column: 2; }
  .related { margin-top: 4rem; }
  .related h2 { font-size: 1.5rem; margin-bottom: 1.5rem; }
  @media (max-width: 1024px) { .post-layout { grid-template-columns: 1fr; } .toc { display: none; } }
  @media (max-width: 640px) { .post-nav { grid-template-columns: 1fr; } .post-nav .right { grid-column: 1; } }
</style>
