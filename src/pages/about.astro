---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE, SOCIALS } from '../consts';

const link = (name: string) => SOCIALS.find((s) => s.name === name)!.url;

const skills = ['Microsoft Azure', 'Kubernetes / AKS', 'Terraform', 'Bicep', 'GitHub Actions', 'Azure DevOps', 'Docker', 'Python', 'Azure AI Foundry', 'Linux'];
---

<BaseLayout title="About" description={`About ${SITE.author}`}>
  <div class="container about">
    <div class="about-header">
      <img src={SITE.avatar} alt={SITE.author} width="160" height="160" />
      <div>
        <span class="tag">{SITE.role}</span>
        <h1>About Me</h1>
        <SocialLinks />
      </div>
    </div>
    <div class="prose">
      <p>
        Hi! I'm <strong>{SITE.author}</strong>, a {SITE.role.toLowerCase()} passionate about building reliable,
        automated cloud platforms. I spend my time working with Azure, Kubernetes, Infrastructure as Code and AI services.
      </p>
      <p>
        This blog is where I share what I learn — practical, hands-on guides, lessons from real-world projects, and notes
        from my certification journey. I hope you find something useful here.
      </p>
      <h2>What I work with</h2>
      <div class="skills">{skills.map((s) => <span class="tag">{s}</span>)}</div>
      <h2>Get in touch</h2>
      <p>
        The best way to reach me is via <a href={link('LinkedIn')}>LinkedIn</a>,
        <a href={link('X')}>X</a> or <a href={link('GitHub')}>GitHub</a>. You can also follow new posts via
        <a href="/rss.xml">RSS</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .about { padding-top: 3rem; max-width: 860px; }
  .about-header { display: flex; gap: 2rem; align-items: center; margin-bottom: 2.5rem; flex-wrap: wrap; }
  .about-header img { border-radius: 50%; border: 4px solid var(--color-border); box-shadow: 0 0 0 8px var(--color-primary-soft); }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.75rem 0 1rem; }
  .socials { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .skills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .skills .tag { font-size: 0.85rem; padding: 0.35rem 0.85rem; }
</style>
